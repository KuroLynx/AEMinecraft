  "swiftness": ["nether_wart", "sugar"],
  "slowness": ["nether_wart", "sugar", "fermented_spider_eye"],
  "healing": ["nether_wart", "glistering_melon_slice"],
  "harming": ["nether_wart", "glistering_melon_slice", "fermented_spider_eye"],
  "poison": ["nether_wart", "spider_eye"],
  "regeneration": ["nether_wart", "ghast_tear"],
  "night_vision": ["nether_wart", "golden_carrot"],
  "invisibility": ["nether_wart", "golden_carrot", "fermented_spider_eye"],
  "water_breathing": ["nether_wart", "pufferfish"],
  "leaping": ["nether_wart", "rabbit_foot"],
  "slow_falling": ["nether_wart", "phantom_membrane"],
  "turtle_master": ["nether_wart", "turtle_helmet"],
  "wind_charged": ["nether_wart", "breeze_rod"],
